# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Facebook Messenger Platform — get from https://developers.facebook.com/apps

# Page Access Token: Generated per Facebook Page in App Dashboard > Messenger > Settings
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token-here

# App Secret: Found in App Dashboard > Settings > Basic. Used to verify webhook signatures.
FACEBOOK_APP_SECRET=your-app-secret-here

# Verify Token: A random string YOU choose. Must match what you enter when subscribing the webhook.
FACEBOOK_VERIFY_TOKEN=pick-any-random-string-here

# App ID: Found in App Dashboard top bar.
FACEBOOK_APP_ID=your-numeric-app-id-here

# ============================================================
# ACTIVE HOURS (optional — Messenger webhook gate)
# ============================================================
# The bot covers the overnight shift. Outside this window it drops every
# webhook event: no replies sent, no pause state touched, no OpenAI calls.
#
# Start is inclusive, end is exclusive, whole hours only. The window may
# wrap midnight — the default below means active 23:00 through 08:59.
# Times are always Asia/Dhaka, whatever the server's own timezone is.
#
# START must be 0-23. END must be 0-24, where 24 means end of day.
# Setting START and END to the same value is an error and the app will
# refuse to start. For an always-active bot, use START=0 and END=24.
BOT_ACTIVE_START_HOUR=23
BOT_ACTIVE_END_HOUR=9

# Whole days on which the bot is active regardless of the window above.
# Comma-separated full English weekday names, case-insensitive, spaces
# around each name ignored, a trailing comma is fine. Empty/unset means
# the window alone decides — the default, and unchanged behaviour.
#
# Full names only: "fri" is rejected. One spelling per day keeps the
# parse surface small, and the error message lists all seven valid names.
# An unknown name STOPS THE APP FROM STARTING rather than being read as
# "no always-active days", which would look exactly like the feature
# being switched off.
#
# Weekdays are evaluated in Asia/Dhaka, like the window — not in the
# container's own timezone.
#
# With friday and the 23->9 window below, the bot is continuously active
# from Thursday 23:00 to Saturday 09:00: the window carries Thu 23:00 ->
# Fri 09:00, the day rule carries all of Friday, the window carries
# Sat 00:00 -> 09:00. Friday is the client's holiday, when no rep is at
# Page Inbox.
BOT_ALWAYS_ACTIVE_DAYS=
